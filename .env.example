# PostgreSQL
POSTGRES_DB=BidNexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# JWT
JWT_KEY=replace-with-a-long-random-secret
JWT_ISSUER=BidNexus
JWT_AUDIENCE=BidNexusClient
JWT_EXPIRY_MINUTES=30

# Frontend
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

# Leave empty when frontend and API are served through the same Nginx origin.
VITE_API_URL=
